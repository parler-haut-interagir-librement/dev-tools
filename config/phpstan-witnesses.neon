# The witnesses of the forbidden calls: files under `tests/Witnesses/PhpStan` that MUST fail. `phil-dev witnesses`
# runs this analysis and passes only when PHPStan reports, in each witness, the identifier its docblock announces.
# The level is the lowest: what is measured here is the rule, not the rest of the file.
includes:
    - phpstan-disallowed.php
    - phpstan-witnesses.php

parameters:
    level: 0
