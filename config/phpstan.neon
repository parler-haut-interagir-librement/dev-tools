# The shared PHPStan configuration. A project's `phpstan.neon` includes this file and sets its own `tmpDir`, and
# whatever only it needs (a Symfony container, a Doctrine object manager).
#
# `phpstan/extension-installer` loads phpstan-doctrine, phpstan-phpunit, phpstan-symfony, phpstan-strict-rules,
# phpstan-deprecation-rules, type-coverage and cognitive-complexity on its own. `phpstan-disallowed.php` adds the sets
# of forbidden calls; `phpstan-symplify.php` the rules of symplify/phpstan-rules every package follows;
# `phpstan-workspace.php` adds the paths of the root and of each package, and the exceptions their
# `phil-dev.php` declare.
#
# Bleeding edge turns on the checks of the next major version of PHPStan now, so that it brings no surprise.
includes:
    - phar://phpstan.phar/conf/bleedingEdge.neon
    - phpstan-disallowed.php
    - phpstan-symplify.php
    - phpstan-workspace.php

parameters:
    level: max

    # phpVersion comes from config/matrix.json, through phpstan-workspace.php: from the floor to the next PHP.

    # The maximum level does not cover these three, and each is a place where a bug hides behind a type that looks
    # right.
    checkUninitializedProperties: true
    checkBenevolentUnionTypes: true
    treatPhpDocTypesAsCertain: true

    # Every parameter, return, property and constant is typed natively: a PHPDoc type refines a native one, it never
    # replaces it.
    type_coverage:
        return: 100
        param: 100
        property: 100
        constant: 100

    # A method a reader holds in their head at once, a class that does one thing. A method above the bar is split,
    # or carries its exception in its package's phil-dev.php, with the reason.
    cognitive_complexity:
        class: 100
        function: 25

    # An exception that no longer matches anything is an exception nobody needs; the shared ones below do not count,
    # since a package may have nothing they apply to.
    reportUnmatchedIgnoredErrors: true

    # Files derived at cache warm-up, and the witnesses, which must fail and are analysed apart; `phpstan-workspace.php`
    # adds each package's own.
    excludePaths:
        analyse:
            - '*/config/reference.php'
            - '*/tests/Witnesses/*'

    ignoreErrors:
        # The marker interface of a package's exceptions lives with them, in its Exception namespace, as the rule on
        # exception namespaces asks; the Contract namespace is for the interfaces of services.
        -
            identifier: symplify.requiredInterfaceContractNamespace
            path: '*/Exception/*'
            reportUnmatched: false

        # A test may assert what static analysis already proves: that a compiled container returns a given object,
        # that a method does not exist. The test is there for the day the proof stops holding. Restricted to tests:
        # in production code, an always-true comparison is a defect.
        -
            identifier: staticMethod.alreadyNarrowedType
            path: '*/tests/*'
            reportUnmatched: false
        -
            identifier: function.impossibleType
            path: '*/tests/*'
            reportUnmatched: false

        # The timing-safe codecs are required everywhere, because a secret may pass through an encoding. A test only
        # encodes published vectors and fixture values: the rule protects nothing there, and pushes towards workarounds
        # (`pack('H*', …)`) that read worse than `hex2bin()`. In production code, each exception is written on its line
        # with its reason, so that it follows the package into its own repository.
        -
            identifier: disallowed.function
            message: '#^Calling (hex2bin|bin2hex|base64_decode|base64_encode)\(\) is forbidden, it is not timing-safe#'
            path: '*/tests/*'
            reportUnmatched: false
