# The forbidden calls of every PHIL and Tilttek package, besides the sets of `spaze/phpstan-disallowed-calls` that
# `phpstan-disallowed.php` includes. The witnesses under `tests/Witnesses/PhpStan` prove each rule still fires: what
# tests may do is allowed in the test suites by name, so that the witnesses, beside them, stay under every rule.
parameters:
    disallowedFunctionCalls:
        -
            function: 'unserialize()'
            message: 'PHP native deserialisation is an object-injection surface; decode JSON instead'
            errorIdentifier: 'phil.unserialize'

        -
            function: 'serialize()'
            message: 'use json_encode(); see the note on unserialize()'
            errorIdentifier: 'phil.serialize'
            allowIn:
                - '*/tests/Unit/*'
                - '*/tests/Integration/*'
                - '*/tests/Functional/*'
                - '*/tests/Support/*'
                - '*/tests/Fixtures/*'

        # A dump left in place writes an unredacted payload to a log.
        -
            function:
                - 'var_dump()'
                - 'print_r()'
                - 'var_export()'
                - 'dd()'
                - 'dump()'
            message: 'a dump left in place writes an unredacted payload to a log'
            errorIdentifier: 'phil.dump'
            allowIn:
                - '*/tests/Unit/*'
                - '*/tests/Integration/*'
                - '*/tests/Functional/*'
                - '*/tests/Support/*'
                - '*/tests/Fixtures/*'

        # Identifiers are generated by the caller; `uniqid()` and `rand()` are neither unique nor unpredictable.
        -
            function:
                - 'uniqid()'
                - 'rand()'
                - 'mt_rand()'
                - 'shuffle()'
                - 'array_rand()'
            message: 'use random_int(), random_bytes() or a Randomizer, or symfony/uid for an identifier'
            errorIdentifier: 'phil.weakRandom'

    # Symfony compiles the event dispatcher: `addListener()` on the shared dispatcher and autowiring by the component's
    # interface are deprecated. The type is that of the contracts, everywhere.
    disallowedClasses:
        -
            class: 'Symfony\Component\EventDispatcher\EventDispatcherInterface'
            message: 'type by Symfony\Contracts\EventDispatcher\EventDispatcherInterface, the interface of the contracts'
            errorIdentifier: 'phil.componentDispatcher'
